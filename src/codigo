<script>
(function(){

const pad=document.getElementById('joystick');
const stick=document.getElementById('stick');
const status=document.getElementById('status');
const indicator=document.getElementById('indicator');
const stopButton=document.getElementById('stopButton');

let pointerId=null;
let current='stop';
let lastSent=0;
let heartbeat=null;
let requestChain=Promise.resolve();

const labels={
forward:'MOTOR A: ADELANTE',
backward:'MOTOR A: ATRÁS',
left:'MOTOR B: IZQUIERDA',
right:'MOTOR B: DERECHA',
stop:'MOTORES DETENIDOS'
};

function sendCommand(command,force){

const now=Date.now();

if(!force && command===current && now-lastSent<180)return;

current=command;
lastSent=now;

status.textContent=labels[command];

indicator.style.background=
command==='stop'?'#b8ff5a':'#35e7ff';

indicator.style.boxShadow=
command==='stop'?'0 0 10px #b8ff5a':'0 0 10px #35e7ff';

requestChain=requestChain
.catch(function(){})
.then(function(){

return fetch('/'+command,{
method:'GET',
cache:'no-store',
credentials:'same-origin'
});

})
.then(function(response){

if(!response.ok)throw new Error('Error HTTP');

})
.catch(function(){

status.textContent='SIN RESPUESTA DEL ROBOT';
indicator.style.background='#ff4768';
indicator.style.boxShadow='0 0 10px #ff4768';

});

}

function centerStick(){

stick.style.left='50%';
stick.style.top='50%';
stick.classList.remove('active');

}

function stopHeartbeat(){

if(heartbeat!==null){
clearInterval(heartbeat);
heartbeat=null;
}

}

function stop(){

stopHeartbeat();
pointerId=null;
centerStick();
sendCommand('stop',true);

}

function move(event){

const rect=pad.getBoundingClientRect();

const cx=rect.left+rect.width/2;
const cy=rect.top+rect.height/2;

let dx=event.clientX-cx;
let dy=event.clientY-cy;

const max=rect.width*.31;
const dist=Math.hypot(dx,dy);

if(dist>max){
dx=dx/dist*max;
dy=dy/dist*max;
}

stick.style.left='calc(50% + '+dx+'px)';
stick.style.top='calc(50% + '+dy+'px)';
stick.classList.add('active');

if(Math.hypot(dx,dy)<max*.22){
sendCommand('stop',true);
return;
}

const angle=Math.atan2(dy,dx)*180/Math.PI;

let command;

if(angle>=-45 && angle<45){
command='right';
}
else if(angle>=45 && angle<135){
command='backward';
}
else if(angle>=-135 && angle<-45){
command='forward';
}
else{
command='left';
}

sendCommand(command,false);

}

pad.addEventListener('pointerdown',function(e){

e.preventDefault();

if(pointerId!==null)stop();

pointerId=e.pointerId;

try{
pad.setPointerCapture(pointerId);
}catch(_){}

move(e);

stopHeartbeat();

heartbeat=setInterval(function(){

if(pointerId!==null && current!=='stop'){
sendCommand(current,true);
}

},250);

});

pad.addEventListener('pointermove',function(e){

if(e.pointerId===pointerId){
e.preventDefault();
move(e);
}

});

pad.addEventListener('pointerup',function(e){

if(e.pointerId===pointerId)stop();

});

pad.addEventListener('pointercancel',function(e){

if(e.pointerId===pointerId)stop();

});

pad.addEventListener('lostpointercapture',function(){

if(pointerId!==null)stop();

});

window.addEventListener('pointerup',function(){

if(pointerId!==null)stop();

});

window.addEventListener('blur',function(){

if(pointerId!==null)stop();

});

document.addEventListener('visibilitychange',function(){

if(document.hidden)stop();

});

stopButton.addEventListener('click',stop);

window.addEventListener('pagehide',function(){

stopHeartbeat();

fetch('/stop',{
method:'GET',
cache:'no-store',
keepalive:true
}).catch(function(){});

});

})();
</script>

