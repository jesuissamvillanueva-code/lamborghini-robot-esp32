// =====================================================
//                 CONTROL DE MOTORES
// =====================================================

// DETENER LOS DOS MOTORES
void stopMotors(){

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);

  giroTemporizado = false;

}


// MOTOR A: ADELANTE
void moveForward(){

  stopMotors();

  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

}


// MOTOR A: ATRAS
void moveBackward(){

  stopMotors();

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);

}


// MOTOR B: IZQUIERDA
void turnLeft(){

  stopMotors();

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);

  // Apaga el motor de giro al terminar el pulso de 200 ms.
  giroTemporizado = true;
  finPulsoGiro = millis() + TIEMPO_GIRO;

}


// MOTOR B: DERECHA
void turnRight(){

  stopMotors();

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  // Apaga el motor de giro al terminar el pulso de 200 ms.
  giroTemporizado = true;
  finPulsoGiro = millis() + TIEMPO_GIRO;

}


// =====================================================
//                  PAGINA PRINCIPAL
// =====================================================

void handleRoot(){

  server.send_P(
    200,
    "text/html; charset=utf-8",
    html_page
  );

}


// =====================================================
//                    CONFIGURACION
// =====================================================

void setup(){

  Serial.begin(115200);

  ultimaOrdenMovimiento = millis();

  // CONFIGURAR PINES DE MOTORES
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  // CONFIGURAR LED
  pinMode(LED_AZUL, OUTPUT);

  stopMotors();

  digitalWrite(LED_AZUL, LOW);


  // ===========================================
  //         WIFI CON IP FIJA
  // ===========================================

  WiFi.mode(WIFI_AP);

  if(!WiFi.softAPConfig(local_IP, gateway, subnet)){

    Serial.println("ERROR: No se pudo configurar IP fija");

  }

  if(!WiFi.softAP(ssid, password)){

    Serial.println("ERROR: No se pudo crear la red WiFi");

  }
  else{

    Serial.println();
    Serial.println("==============================");
    Serial.println("     LAMBORGHINI ROBOT");
    Serial.println("==============================");

    Serial.print("WIFI: ");
    Serial.println(ssid);

    Serial.print("PASSWORD: ");
    Serial.println(password);

    Serial.print("IP FIJA: ");
    Serial.println(WiFi.softAPIP());

    Serial.println("ABRIR: http://192.168.4.1");

    digitalWrite(LED_AZUL, HIGH);

  }


  // ===========================================
  //              RUTAS DEL SERVIDOR
  // ===========================================

  server.on("/", HTTP_GET, handleRoot);


  // MOTOR A: ADELANTE
  server.on("/forward", HTTP_GET, [](){

    ultimaOrdenMovimiento = millis();

    moveForward();

    server.send(200, "text/plain", "FORWARD");

  });


  // MOTOR A: ATRAS
  server.on("/backward", HTTP_GET, [](){

    ultimaOrdenMovimiento = millis();

    moveBackward();

    server.send(200, "text/plain", "BACKWARD");

  });


  // MOTOR B: IZQUIERDA
  server.on("/left", HTTP_GET, [](){

    ultimaOrdenMovimiento = millis();

    turnLeft();

    server.send(200, "text/plain", "LEFT");

  });


  // MOTOR B: DERECHA
  server.on("/right", HTTP_GET, [](){

    ultimaOrdenMovimiento = millis();

    turnRight();

    server.send(200, "text/plain", "RIGHT");

  });


  // DETENER MOTORES
  server.on("/stop", HTTP_GET, [](){

    ultimaOrdenMovimiento = millis();

    stopMotors();

    server.send(200, "text/plain", "STOP");

  });


  // INICIAR SERVIDOR
  server.begin();

  Serial.println("Servidor web iniciado");
  Serial.println("Robot listo para funcionar");

}


// =====================================================
//                     BUCLE PRINCIPAL
// =====================================================

void loop(){

  server.handleClient();

  // AJUSTE EXCLUSIVO DE IZQUIERDA Y DERECHA:
  // cada pulso de giro dura 200 ms; luego se detiene.
  if(giroTemporizado &&
     (long)(millis() - finPulsoGiro) >= 0){

    stopMotors();

  }

  // PARADA AUTOMATICA DE SEGURIDAD
  if(millis() - ultimaOrdenMovimiento >
     TIEMPO_MAXIMO_SIN_ORDEN){

    stopMotors();

  }

}
